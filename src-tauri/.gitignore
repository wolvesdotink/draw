# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Xcode / iOS build artifacts. We commit gen/apple/ (the project itself) so
# CI and teammates have a working Xcode project, but exclude transient
# build outputs and per-user editor state.
/gen/apple/Externals
/gen/apple/Pods
/gen/apple/build
/gen/apple/**/xcuserdata
