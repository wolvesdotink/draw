{
  "$schema": "../gen/schemas/ios-schema.json",
  "identifier": "mobile",
  "description": "Capability for the iOS / iPadOS main window. Drops desktop-only permissions (window dragging, updater, process restart) since iOS apps update via the App Store.",
  "platforms": ["iOS", "android"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-app-read-recursive",
    "fs:allow-app-write-recursive",
    "dialog:allow-open",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/drawings" },
        { "path": "$APPDATA/drawings/**" },
        { "path": "$APPDATA/state.json" }
      ]
    }
  ]
}
