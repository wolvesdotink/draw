{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "draw",
  "version": "0.2.10",
  "identifier": "ink.wolves.draw",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "draw",
        "width": 1200,
        "height": 800,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Local-first Excalidraw desktop app.",
    "longDescription": "draw is a brutalist, local-first desktop app for Excalidraw. Drawings live as plain .excalidraw files in ~/Library/Application Support, autosaved continuously, with full offline support.",
    "copyright": "Copyright (c) 2026 Wolves Software. All rights reserved.",
    "publisher": "Wolves Software",
    "homepage": "https://wolves.ink",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "background": "icons/dmg-background.png",
        "appPosition": {
          "x": 200,
          "y": 240
        },
        "applicationFolderPosition": {
          "x": 520,
          "y": 240
        },
        "windowSize": {
          "width": 720,
          "height": 480
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1MkIxNjI3MzQwRTk4NzgKUldSNG1BNDBKeFlyZFoyUVJmaTBrT2ZXdXJWY0d5N0o3ak5ZaWQ5THRLU0lxQS9IbDZGK083bG4K",
      "endpoints": [
        "https://github.com/wolvesdotink/draw/releases/latest/download/latest.json"
      ]
    }
  }
}
